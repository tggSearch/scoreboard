# 复制到 Jenkins 节点: ${CERT_DIR}/jenkins_secrets.env
# 勿提交真实密钥到 Git

# 腾讯云 COS（APK 上传）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=apk-1251046496
COS_BUCKET_PATH=apk
COS_REGION=ap-guangzhou

# App Store Connect API
IOS_API_KEY_ID=
IOS_API_ISSUER_ID=
IOS_API_KEY_PATH=/Users/dan/Documents/cert/4GN8P39YH9.p8

# Google Play 服务账号 JSON 路径
ANDROID_SERVICE_ACCOUNT_JSON=/Users/dan/Documents/cert/tudan.json

# ScoreBoard 专用 upload keystore（SHA1 须匹配 Play Console）
ANDROID_UPLOAD_KEYSTORE=/Users/dan/Documents/cert/scoreboard-upload-keystore.jks
# 可选：覆盖期望指纹（一般不用改）
# GOOGLE_PLAY_UPLOAD_SHA1=8B:60:AB:7A:BA:1E:28:B4:3C:99:60:D5:2D:B0:01:A9:AB:79:50:FF
