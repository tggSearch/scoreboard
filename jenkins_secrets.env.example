# 复制到 Jenkins 节点: ${CERT_DIR}/jenkins_secrets.env
# 勿提交真实密钥到 Git

# 腾讯云 COS（APK 上传）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=apk-1251046496
COS_BUCKET_PATH=apk
COS_REGION=ap-guangzhou

# Google Play 服务账号 JSON 路径
ANDROID_SERVICE_ACCOUNT_JSON=/Users/dan/Documents/cert/tudan.json

# ScoreBoard 专用 upload keystore
# 默认使用仓库 certs/scoreboard-upload-keystore.jks（SHA1 8E:9F:...）
# ANDROID_UPLOAD_KEYSTORE=/path/to/scoreboard-upload-keystore.jks
# ANDROID_UPLOAD_KEYSTORE_BASE64=
# ANDROID_KEY_STORE_PASSWORD=scoreboard123
# ANDROID_KEY_PASSWORD=scoreboard123
# ANDROID_KEY_ALIAS=upload
# GOOGLE_PLAY_UPLOAD_SHA1=8E:9F:91:5E:D2:CE:FE:2D:64:0D:C5:B3:E3:CC:FD:60:50:D0:36:BD

# App Store Connect API / match
IOS_API_KEY_ID=4GN8P39YH9
IOS_API_ISSUER_ID=aabd36b8-9b8f-44ed-a8db-5afff7624ad6
IOS_API_KEY_PATH=/Users/dan/Documents/cert/4GN8P39YH9.p8
MATCH_PASSWORD=match
MATCH_GIT_BRANCH=scoreboard
MATCH_READONLY=true
