# 复制到 Jenkins 节点: ${CERT_DIR}/jenkins_secrets.env
# 勿提交真实密钥到 Git

# 腾讯云 COS（APK 上传）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=apk-1251046496
COS_BUCKET_PATH=apk
COS_REGION=ap-guangzhou

# App Store Connect API
IOS_API_KEY_ID=
IOS_API_ISSUER_ID=
IOS_API_KEY_PATH=/Users/dan/Documents/cert/4GN8P39YH9.p8

# Google Play 服务账号 JSON 路径
ANDROID_SERVICE_ACCOUNT_JSON=/Users/dan/Documents/cert/tudan.json

# Android upload keystore（任选其一）
# 方式 1：与 texasWinRate 共用文件
# ANDROID_UPLOAD_KEYSTORE=/Users/dan/Documents/cert/upload-keystore.jks
# 方式 2：Jenkins Secret Text 注入 base64（脚本会自动解码写入 android/app/）
# ANDROID_UPLOAD_KEYSTORE_BASE64=
# 方式 3：自定义密码（不设则默认 upload/android）
# ANDROID_KEY_STORE_PASSWORD=android
# ANDROID_KEY_PASSWORD=android
# ANDROID_KEY_ALIAS=upload
