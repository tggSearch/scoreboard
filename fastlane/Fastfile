# frozen_string_literal: true
default_platform(:ios)

platform :ios do
  lane :sync_certificates do |options|
    readonly = options.fetch(:readonly, true)
    readonly = true if readonly.to_s == "true"
    readonly = false if readonly.to_s == "false"

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("IOS_API_KEY_ID"),
      issuer_id: ENV.fetch("IOS_API_ISSUER_ID"),
      key_filepath: ENV.fetch("IOS_API_KEY_PATH"),
      duration: 1200,
      in_house: false
    )
    if ENV["JENKINS_IOS_WWDR_READY"] == "1"
      FastlaneCore::CertChecker.define_singleton_method(:install_missing_wwdr_certificates) do |in_keychain: nil|
        0
      end
    end
    match(
      type: "appstore",
      readonly: readonly,
      shallow_clone: true,
      clone_branch_directly: readonly,
      force: options.fetch(:force, false).to_s == "true",
      skip_confirmation: true,
      skip_set_partition_list: true,
      api_key: api_key
    )
  end
end